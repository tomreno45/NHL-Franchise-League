# Copy to .env for local dev. In production (Railway), set these as real
# environment variables in the service's dashboard instead — never commit
# actual secrets or connection strings.

# Session store — a database that always exists regardless of which league
# a session picks (see db.js's sessionPool comment). Can be the same
# Postgres instance as the league databases below, just a separate database
# name within it.
DATABASE_URL=postgres://user:password@host:5432/hockey_franchise

# One Postgres database per league — fully independent data, same schema.
# Adding a league also requires a matching entry in db.js's LEAGUES object.
DATABASE_URL_TEST=postgres://user:password@host:5432/hockey_franchise_test
DATABASE_URL_DEVELOPMENT=postgres://user:password@host:5432/hockey_franchise_development
DATABASE_URL_PRODUCTION=postgres://user:password@host:5432/hockey_franchise_production
DATABASE_URL_OG_HFL=postgres://user:password@host:5432/hockey_franchise_og_hfl

PORT=4000

# Long random string — used to sign the session cookie. Generate a real one
# with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me

# Only matters in local dev (client and server on different ports) — in
# production the server serves the built client itself, same-origin, so
# this isn't used.
CLIENT_ORIGIN=http://localhost:5173

# Set to "production" on the real deployment (Railway sets this
# automatically) — flips the session cookie to require HTTPS and turns on
# serving the built client (see server.js).
NODE_ENV=development

# Web Push (browser notifications) — one key pair for the whole app, not
# per-league. Generate a real pair with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# VAPID_SUBJECT must be a mailto: or https: URL the push services can use
# to contact you if they need to (their requirement, not this app's). Push
# is simply disabled (routes 404 gracefully) if these aren't set.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
